# Database connection string (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/dbname?sslmode=require

# Secret key and debug settings (optional for local dev)
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True

# Cloudinary - public preview images (signed direct upload from the app).
# Real values belong in .env (gitignored) and the Vercel dashboard, never here.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Cloudflare R2 - private design files (presigned upload/download URLs).
# The token needs Object Read & Write on this bucket only.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-private-bucket-name

# Cron - protects the storage cleanup endpoint (storage/urls.py). Vercel sets
# this same value automatically when a Cron Job is configured for the
# project; set it here to match for local testing. Any random string of at
# least 16 characters works - e.g. `openssl rand -hex 32`.
CRON_SECRET=your-cron-secret
FIREBASE_PROJECT_ID=your_firebase_project_id

# Email - sends the password reset code. Leave EMAIL_HOST_USER empty in local
# development: the email is printed in the runserver terminal instead.
# For Gmail, EMAIL_HOST_PASSWORD is an APP PASSWORD (Google account -> Security
# -> 2-Step Verification -> App passwords), never the account password.
# Real values belong in .env (gitignored) and the Vercel dashboard, never here.
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=CNC Design <your-address@gmail.com>
# Optional (these are the defaults):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
